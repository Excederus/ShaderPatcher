{
  "schemaVersion": 1,
  "id": "shaderpatcher",
  "version": "${version}",
  "name": "Shader Patcher",
  "description": "Attempts to add mod support to any shaderpack",
  "authors": [
    "Excederus"
  ],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/Excederus/ShaderPatcher"
  },
  "license": "LGPL-3.0",
  "icon": "assets/shaderpatcher/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.example.ExampleMod"
    ],
    "client": [
      "com.example.client.ExampleModClient"
    ]
  },
  "mixins": [
    "modid.mixins.json",
    {
      "config": "modid.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}