{
  "schemaVersion": 1,
  "id": "shaderpatcher",
  "version": "${version}",
  "name": "Shader Patcher",
  "description": "Attempts to add mod support to any shaderpack",
  "authors": [
    "Excederus"
  ],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/Excederus/ShaderPatcher"
  },
  "license": "LGPL-3.0",
  "icon": "assets/shaderpatcher/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.excederus.shaderpatcher.FabricEntrypoint"
    ]
  },
  "depends": {
    "fabricloader": "${loader_version_range}",
